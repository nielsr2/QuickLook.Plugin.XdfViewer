<UserControl x:Class="QuickLook.Plugin.XdfViewer.XdfPreviewPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:QuickLook.Plugin.XdfViewer.Controls"
             Background="Transparent">
  <Grid Margin="16">
    <!-- Busy / error / content are toggled from code-behind -->
    <TextBlock x:Name="BusyText" Text="Reading XDF…" Opacity="0.6"
               VerticalAlignment="Center" HorizontalAlignment="Center"/>
    <TextBlock x:Name="ErrorText" Visibility="Collapsed" TextWrapping="Wrap"
               VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.8"/>
    <DockPanel x:Name="Root" Visibility="Collapsed">
      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
        <!-- Settings (upper-right-most): gear opens the plugin settings popup (waveform color
             theme, etc.). Popup content/wiring lives in Settings/ + code-behind. -->
        <ToggleButton x:Name="SettingsButton" DockPanel.Dock="Right" Width="28" Height="28"
                      Margin="8,0,0,0" VerticalAlignment="Top" Padding="0"
                      Content="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                      ToolTip="Settings"/>
        <Popup PlacementTarget="{Binding ElementName=SettingsButton}" Placement="Bottom"
               StaysOpen="False" AllowsTransparency="True"
               IsOpen="{Binding IsChecked, ElementName=SettingsButton, Mode=TwoWay}">
          <Border Background="{DynamicResource PanelBackground}" BorderBrush="#55888888"
                  BorderThickness="1" Padding="12" CornerRadius="6" Margin="0,4,10,10">
            <Border.Effect>
              <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
            </Border.Effect>
            <StackPanel>
              <TextBlock Text="WAVEFORM COLOR" FontSize="10" Opacity="0.6" Margin="0,0,0,6"/>
              <!-- Item order MUST exactly match the WaveformColorTheme enum declaration order
                   (Mono, Ocean, Sunset, Forest, Berry, Custom): SelectedIndex is cast straight
                   to the enum in code-behind. -->
              <ComboBox x:Name="WaveformThemeCombo" Width="160" SelectionChanged="WaveformThemeCombo_SelectionChanged">
                <ComboBoxItem>Mono</ComboBoxItem>
                <ComboBoxItem>Ocean</ComboBoxItem>
                <ComboBoxItem>Sunset</ComboBoxItem>
                <ComboBoxItem>Forest</ComboBoxItem>
                <ComboBoxItem>Berry</ComboBoxItem>
                <ComboBoxItem>Purple</ComboBoxItem>
                <ComboBoxItem>Custom…</ComboBoxItem>
              </ComboBox>
              <!-- Custom color swatch: previews/edits PluginSettings.CustomWaveformColor; only
                   shown when the Custom theme is selected. -->
              <Button x:Name="CustomColorSwatch" Click="CustomColorSwatch_Click" Margin="0,8,0,0"
                      Height="24" HorizontalAlignment="Stretch" Visibility="Collapsed"/>
            </StackPanel>
          </Border>
        </Popup>
        <!-- Channel search (upper right): filters channel rows by label across all stream cards. -->
        <Grid x:Name="ChannelSearchGrid" DockPanel.Dock="Right" Width="220"
              VerticalAlignment="Top" Margin="12,0,0,0">
          <TextBox x:Name="ChannelSearchBox" Padding="6,3" TextChanged="ChannelSearchBox_TextChanged"/>
          <TextBlock x:Name="ChannelSearchPlaceholder" Text="Filter channels…"
                     Margin="9,0,0,0" VerticalAlignment="Center" Opacity="0.45" IsHitTestVisible="False"/>
        </Grid>
        <!-- No filename here: QuickLook's own window chrome already shows it. -->
        <TextBlock x:Name="SummaryText" Opacity="0.7" VerticalAlignment="Center"/>
      </DockPanel>
      <!-- Scrolling is disabled here on purpose: it makes the grid measure against the window
           instead of infinity, so cards fill the available height and each card's own list
           scrolls internally rather than the whole page scrolling. -->
      <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl x:Name="StreamsList" SizeChanged="StreamsList_SizeChanged">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <!-- Uniform columns (count computed from the width) so cards stretch to fill it -->
              <UniformGrid Columns="{Binding CardColumns,
                             RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="0,0,12,12" Padding="12" CornerRadius="8"
                      BorderThickness="1" BorderBrush="#33888888" Background="#11888888">
                <Grid>
                  <!-- Stream-type icon: anchored to the card's own top-right corner (not the
                       header row), since that corner is otherwise empty screen real estate. -->
                  <Path Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Stretch="Uniform"
                        Data="{Binding Kind, Converter={StaticResource KindToGeometry}}"
                        Fill="{DynamicResource WaveformBrush}" Opacity="0.75"
                        ToolTip="{Binding KindTooltip}"/>
                  <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,36,0">
                      <Border DockPanel.Dock="Right" Visibility="{Binding IsIncomplete,
                                Converter={StaticResource BoolToVis}}"
                              Background="#33CC7722" CornerRadius="4" Padding="4,1" Margin="6,0,0,0">
                        <TextBlock Text="incomplete" FontSize="10" Opacity="0.9"/>
                      </Border>
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding ChannelsLine}" Opacity="0.8" Margin="0,6,0,0"/>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding RateLine}" Opacity="0.8"/>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding DurationLine}" Opacity="0.8"/>
                    <!-- Top-anchored: sits directly under the metadata rather than floating in the
                         middle of a tall card, and grows downward as far as the card allows (the list
                         inside scrolls once it runs out of room). -->
                    <Expander Header="{Binding ExpanderHeader}" Margin="0,6,0,0"
                              IsExpanded="True" VerticalAlignment="Top"
                              VerticalContentAlignment="Stretch">
                    <Grid>
                      <!-- Channels (numeric streams) -->
                      <ItemsControl ItemsSource="{Binding Channels}"
                                    Visibility="{Binding IsMarkerStream,
                                      Converter={StaticResource InverseBoolToVis}}">
                        <ItemsControl.Template>
                          <ControlTemplate>
                            <!-- Right padding reserves a gutter for the scrollbar thumb, which
                                 otherwise floats on top of the content (rather than in its own
                                 column) and covered the right edge of the sparklines. -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="True"
                                          Padding="0,0,14,0">
                              <ItemsPresenter/>
                            </ScrollViewer>
                          </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <StackPanel Margin="0,1"
                                        Visibility="{Binding IsFilteredOut, Converter={StaticResource InverseBoolToVis}}">
                              <Border Background="Transparent" Cursor="Hand"
                                      MouseLeftButtonUp="ChannelRow_MouseLeftButtonUp">
                                <DockPanel>
                                  <!-- Sparkline docked right so it aligns across rows regardless of label width -->
                                  <controls:WaveformSparkline DockPanel.Dock="Right" Width="100" Height="16" Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Envelope="{Binding Sparkline}"
                                    LineBrush="{DynamicResource WaveformBrush}"
                                    Visibility="{Binding HasWaveform, Converter={StaticResource BoolToVis}}"/>
                                  <!-- Flat-channel warning: sits just left of the sparkline -->
                                  <TextBlock DockPanel.Dock="Right" Text="&#x26A0;&#xFE0E;"
                                    FontFamily="Segoe UI Symbol" FontSize="12" Foreground="#9A9A9A"
                                    VerticalAlignment="Center" Margin="8,0,0,0"
                                    ToolTip="Flat channel — a constant value throughout the previewed data (often a disconnected or unused sensor)."
                                    Visibility="{Binding IsFlat, Converter={StaticResource BoolToVis}}"/>
                                  <TextBlock Opacity="0.85" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding Label, Mode=OneWay}"/>
                                    <Run Text="{Binding Unit, Mode=OneWay}" FontStyle="Italic" Foreground="#888"/>
                                  </TextBlock>
                                </DockPanel>
                              </Border>
                              <StackPanel Margin="0,4,0,6"
                                          Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                <Border Background="Transparent" Cursor="Hand"
                                        MouseLeftButtonUp="ExpandedPlot_Click"
                                        ToolTip="Click for a full-window, scrollable view">
                                  <controls:WaveformSparkline HorizontalAlignment="Stretch" Height="120" Filled="True"
                                    Envelope="{Binding Detail}"
                                    LineBrush="{DynamicResource WaveformBrush}"/>
                                </Border>
                                <TextBlock Opacity="0.6" FontSize="10" Margin="0,2,0,0">
                                  <Run Text="{Binding Detail.DataMin, Mode=OneWay, StringFormat={}{0:0.###}}"/>
                                  <Run Text=" → "/>
                                  <Run Text="{Binding Detail.DataMax, Mode=OneWay, StringFormat={}{0:0.###}}"/>
                                </TextBlock>
                                <TextBlock Opacity="0.6" FontSize="10">
                                  <Run Text="0 → "/>
                                  <Run Text="{Binding StreamDurationSeconds, Mode=OneWay, StringFormat={}{0:0.0}, TargetNullValue=?}"/>
                                  <Run Text=" s"/>
                                </TextBlock>
                              </StackPanel>
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <!-- Markers (string streams) -->
                      <ItemsControl ItemsSource="{Binding Markers}"
                                    Visibility="{Binding IsMarkerStream,
                                      Converter={StaticResource BoolToVis}}">
                        <ItemsControl.Template>
                          <ControlTemplate>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,14,0">
                              <ItemsPresenter/>
                            </ScrollViewer>
                          </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <TextBlock Opacity="0.85">
                              <Run Text="{Binding TimeLabel, Mode=OneWay}" Foreground="#888"/>
                              <Run Text="  "/>
                              <Run Text="{Binding Value, Mode=OneWay}"/>
                            </TextBlock>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <!-- Shown when a search filters out every channel of this (numeric) stream -->
                      <TextBlock Text="no matching channels" Opacity="0.5" FontSize="11"
                                 Margin="2,4,0,0" VerticalAlignment="Top"
                                 Visibility="{Binding NoChannelMatch, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                  </Expander>
                </DockPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>

    <!-- Full-window view of one channel (the 3rd zoom level): a windowed signal viewer.
         Wheel zooms (down to individual samples), Shift+wheel / drag / minimap / scrollbar pan.
         Overlays the whole panel; DataContext is set to the clicked ChannelViewModel. -->
    <Grid x:Name="FullView" Visibility="Collapsed" Focusable="True" FocusVisualStyle="{x:Null}"
          Background="{DynamicResource PanelBackground}"
          PreviewKeyDown="FullView_PreviewKeyDown">
      <DockPanel Margin="4">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
          <Button DockPanel.Dock="Right" Content="✕ Close" Padding="10,3" Cursor="Hand"
                  Background="Transparent" BorderThickness="0"
                  Foreground="{DynamicResource WaveformBrush}"
                  Click="CloseFullView_Click"/>
          <TextBlock x:Name="FullViewTitle" FontSize="15" FontWeight="SemiBold"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
        <TextBlock x:Name="FullViewSubtitle" DockPanel.Dock="Top" Opacity="0.6"
                   FontSize="11" Margin="0,0,0,6"/>
        <!-- Settings row: vertical-scale control + interaction hint (left), minimap navigator (right) -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
          <!-- Minimap navigator: whole-channel overview + draggable viewport rect -->
          <Border x:Name="Minimap" DockPanel.Dock="Right" Width="200" Height="46"
                  Margin="12,0,0,0" VerticalAlignment="Center" CornerRadius="4"
                  Background="#40000000" BorderBrush="#55888888" BorderThickness="1"
                  Cursor="Hand"
                  MouseLeftButtonDown="Mini_MouseLeftButtonDown"
                  MouseMove="Mini_MouseMove"
                  MouseLeftButtonUp="Mini_MouseLeftButtonUp"
                  LostMouseCapture="Mini_LostMouseCapture">
            <Grid>
              <controls:WaveformSparkline x:Name="MiniWave" Filled="True" VerticalInset="4"
                         Margin="4,4,4,4" Envelope="{Binding FullDetail}"
                         LineBrush="{DynamicResource WaveformBrush}"
                         SizeChanged="MiniWave_SizeChanged"/>
              <Canvas>
                <Rectangle x:Name="MiniViewport" Fill="#26FFFFFF" Stroke="#AAFFFFFF"
                           StrokeThickness="1"/>
              </Canvas>
            </Grid>
          </Border>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Vertical scale" Opacity="0.7" FontSize="11" VerticalAlignment="Center"/>
            <Slider x:Name="GainSlider" Minimum="1" Maximum="25" Value="1" Width="180"
                    Margin="8,0" VerticalAlignment="Center"
                    ValueChanged="GainSlider_ValueChanged"/>
            <TextBlock x:Name="GainLabel" Text="×1" Opacity="0.7" FontSize="11"
                       VerticalAlignment="Center" MinWidth="34"/>
            <TextBlock x:Name="MarkerModeLabel" Text="Markers" Opacity="0.7" FontSize="11"
                       VerticalAlignment="Center" Margin="16,0,0,0"/>
            <ComboBox x:Name="MarkerModeCombo" Width="82" Margin="6,0,0,0" VerticalAlignment="Center"
                      SelectedIndex="1" SelectionChanged="MarkerModeCombo_SelectionChanged">
              <ComboBoxItem>Off</ComboBoxItem>
              <ComboBoxItem>Lines</ComboBoxItem>
              <ComboBoxItem>Labels</ComboBoxItem>
            </ComboBox>
            <TextBlock Text="scroll = pan · Shift = zoom · trackpad ↕ zoom" Opacity="0.4"
                       FontSize="11" VerticalAlignment="Center" Margin="16,0,0,0"
                       TextTrimming="CharacterEllipsis"/>
          </StackPanel>
        </DockPanel>
        <!-- Plot: fixed amplitude axis (left) + waveform (fills), time axis + scrollbar below -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <!-- Amplitude (Y) axis: inset top/bottom to match the waveform's vertical padding -->
          <Grid Grid.Column="0" Grid.Row="0" Width="62" Margin="0,12,4,12">
            <TextBlock x:Name="YMaxLabel" VerticalAlignment="Top" HorizontalAlignment="Right"
                       FontSize="10" Opacity="0.7"/>
            <TextBlock x:Name="YMidLabel" VerticalAlignment="Center" HorizontalAlignment="Right"
                       FontSize="10" Opacity="0.7"/>
            <TextBlock x:Name="YMinLabel" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                       FontSize="10" Opacity="0.7"/>
          </Grid>
          <!-- Waveform cell (fills): hosts the wave + the sample-accurate badge. Handles
               wheel zoom/pan and click-drag-pan; clips the transient zoom transform. -->
          <Grid x:Name="PlotCell" Grid.Column="1" Grid.Row="0" Background="Transparent"
                ClipToBounds="True"
                PreviewMouseWheel="PlotCell_PreviewMouseWheel"
                MouseLeftButtonDown="PlotCell_MouseLeftButtonDown"
                MouseMove="PlotCell_MouseMove"
                MouseLeftButtonUp="PlotCell_MouseLeftButtonUp"
                MouseLeave="PlotCell_MouseLeave"
                LostMouseCapture="PlotCell_LostMouseCapture"
                SizeChanged="PlotCell_SizeChanged">
            <controls:WaveformSparkline x:Name="FullWave" ShowGrid="True" Filled="True"
                       VerticalInset="12" SampleDotThresholdPx="6"
                       LineBrush="{DynamicResource WaveformBrush}"/>
            <!-- Marker overlay: vertical event lines (+ value labels in Labels mode). Non-hit-testable
                 so it never intercepts the plot's wheel/drag/move. -->
            <Canvas x:Name="MarkerLayer" IsHitTestVisible="False"/>
            <!-- Hover crosshair: dashed vertical+horizontal guides + a time/amplitude readout.
                 IsHitTestVisible=False so PlotCell keeps receiving wheel/drag/move. -->
            <Canvas x:Name="CrosshairLayer" IsHitTestVisible="False" Visibility="Collapsed">
              <Line x:Name="CrosshairV" StrokeThickness="1" StrokeDashArray="3 3" Opacity="0.55"
                    Stroke="{DynamicResource WaveformBrush}"/>
              <Line x:Name="CrosshairH" StrokeThickness="1" StrokeDashArray="3 3" Opacity="0.55"
                    Stroke="{DynamicResource WaveformBrush}"/>
              <Border x:Name="CrosshairReadout" Background="#CC000000" CornerRadius="3" Padding="5,2">
                <TextBlock x:Name="CrosshairText" FontSize="10" Foreground="White"/>
              </Border>
            </Canvas>
            <!-- Sample-accurate indicator (top-left), shown once zoom reaches ~1 sample/bucket -->
            <Border x:Name="SampleBadge" Visibility="Collapsed"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,6,0,0"
                    Background="#663FB950" CornerRadius="3" Padding="6,2">
              <TextBlock x:Name="SampleBadgeText" FontSize="10" Foreground="White"/>
            </Border>
          </Grid>
          <!-- Time (X) axis for the visible window -->
          <controls:TimeAxis x:Name="TimeAxisEl" Grid.Column="1" Grid.Row="1" Height="22"
                     LabelBrush="{DynamicResource WaveformBrush}"/>
          <!-- Horizontal scrollbar (pan) -->
          <ScrollBar x:Name="FullScrollBar" Grid.Column="1" Grid.Row="2" Orientation="Horizontal"
                     Margin="0,2,0,0" Minimum="0" Scroll="FullScrollBar_Scroll"/>
        </Grid>
      </DockPanel>
    </Grid>
  </Grid>
</UserControl>
